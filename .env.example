PORT=8081
POSTGRES_DB=valence
POSTGRES_USER=valence
POSTGRES_PASSWORD=replace-with-a-random-base64url-secret
VALENCE_DB_MAX_CONNECTIONS=10
VALENCE_DB_AUTO_MIGRATE=true
VALENCE_CHALLENGE_KEY=replace-with-a-32-byte-base64url-secret
VALENCE_TOKEN_KEY=replace-with-a-different-32-byte-base64url-secret
VALENCE_SERVER_CERTIFICATE=replace-with-the-server-certificate
VALENCE_CERTIFICATE_KEY=replace-with-the-server-signing-private-key
REDIS_PASSWORD=replace-with-a-local-redis-password
VALENCE_REDIS_URL=
VALENCE_REDIS_CHANNEL_PREFIX=valence:local
